      },
      {
        "allValue": ".*",
        "datasource": {
          "type": "loki",
          "uid": "${loki_datasource}"
        },
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "query": "label_values({job=\"integrations/mysql\",cluster=~\"$cluster\",job=~\"$job\"}, instance)",
        "refresh": 2,
        "sort": 1,
